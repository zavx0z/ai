{
  "name": "@zavx0z/ai",
  "label": "AI Tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "*",
    "filesystem/*",
    "git/*",
    "server/*",
    "tech/*"
  ],
  "scripts": {
    "start": "bun server/index.ts",
    "start:node": "node --experimental-strip-types server/index.ts",
    "test": "bun test",
    "test:node": "node --experimental-strip-types --test test/node.test.ts",
    "check": "tsc --noEmit",
    "descriptions": "bun server/request/scripts/descriptions.ts",
    "check:descriptions": "bun server/request/scripts/descriptions.ts --check"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.8.3",
    "@types/bun": "1.4.2",
    "@zavx0z/ai-workspace": "workspace:*",
    "@zavx0z/ai-testing": "workspace:*",
    "@zavx0z/ai-filesystem-access": "workspace:*",
    "@zavx0z/ai-filesystem-stat": "workspace:*",
    "@zavx0z/ai-filesystem-read": "workspace:*",
    "@zavx0z/ai-filesystem-read-many": "workspace:*",
    "@zavx0z/ai-filesystem-list": "workspace:*",
    "@zavx0z/ai-filesystem-write": "workspace:*",
    "@zavx0z/ai-filesystem-create": "workspace:*",
    "@zavx0z/ai-filesystem-mkdir": "workspace:*",
    "@zavx0z/ai-filesystem-remove": "workspace:*",
    "@zavx0z/ai-filesystem-rename": "workspace:*",
    "@zavx0z/ai-filesystem-apply-patch": "workspace:*",
    "@zavx0z/ai-git-status": "workspace:*",
    "@zavx0z/ai-server": "workspace:*",
    "@zavx0z/ai-server-request": "workspace:*",
    "@zavx0z/ai-tech-input": "workspace:*",
    "@zavx0z/ai-tech-failure": "workspace:*"
  },
  "engines": {
    "node": ">=22.22.2",
    "bun": ">=1.4.2"
  },
  "description": "Инструменты работы с назначенной хостом директорией и HTTP-вход с явными исполнителями"
}
