{
  "name": "@zavx0z/ai",
  "label": "AI Tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "*",
    "filesystem/*",
    "git/*",
    "server/*",
    "tech/*"
  ],
  "scripts": {
    "start": "bun server/index.ts",
    "start:node": "node --experimental-strip-types server/index.ts",
    "test": "bun test",
    "test:node": "node --experimental-strip-types --test test/node.test.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.8.3",
    "@types/bun": "1.4.2",
