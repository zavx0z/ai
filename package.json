{
  "name": "@zavx0z/ai",
  "label": "AI Tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "*",
    "filesystem/*",
    "git/*",
    "server/*",
    "tech/*"
  ],
  "scripts": {
    "start": "bun server/index.ts",
    "start:node": "node --experimental-strip-types server/index.ts",
    "test": "bun test",
    "test:node": "node --experimental-strip-types --test test/node.test.ts",
    "check": "tsc --noEmit",
    "descriptions": "bun server/request/scripts/descriptions.ts",
    "check:descriptions": "bun server/request/scripts/descriptions.ts --check"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.8.3",
    "@types/bun": "1.4.2",
    "@ai/workspace": "workspace:*",
    "@ai/testing": "workspace:*",
    "@filesystem/access": "workspace:*",
    "@filesystem/stat": "workspace:*",
    "@filesystem/read": "workspace:*",
    "@filesystem/read-many": "workspace:*",
    "@filesystem/list": "workspace:*",
    "@filesystem/write": "workspace:*",
    "@filesystem/create": "workspace:*",
    "@filesystem/mkdir": "workspace:*",
    "@filesystem/remove": "workspace:*",
    "@filesystem/rename": "workspace:*",
    "@filesystem/apply-patch": "workspace:*",
    "@git/status": "workspace:*",
    "@ai/server": "workspace:*",
    "@server/request": "workspace:*",
    "@tech/input": "workspace:*",
    "@tech/failure": "workspace:*"
  },
  "engines": {
    "node": ">=22.22.2",
    "bun": ">=1.4.2"
  },
  "description": "Инструменты работы с назначенной хостом директорией и HTTP-вход с явными исполнителями"
}
