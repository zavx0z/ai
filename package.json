    "@ai/testing": "workspace:*",
    "@filesystem/access": "workspace:*",
    "@filesystem/stat": "workspace:*",
    "@filesystem/read": "workspace:*",
    "@filesystem/read-many": "workspace:*",
    "@filesystem/list": "workspace:*",
    "@filesystem/write": "workspace:*",
    "@filesystem/create": "workspace:*",
    "@filesystem/mkdir": "workspace:*",
    "@filesystem/remove": "workspace:*",
    "@filesystem/rename": "workspace:*",
    "@filesystem/apply-patch": "workspace:*",
    "@git/status": "workspace:*",
    "@ai/server": "workspace:*",
    "@server/request": "workspace:*",
    "@server/discovery": "workspace:*",
    "@tech/input": "workspace:*",
    "@tech/failure": "workspace:*"
  },
  "engines": {
    "node": ">=22.22.2",
    "bun": ">=1.4.2"
  },
  "description": "\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u043e\u0439 \u0445\u043e\u0441\u0442\u043e\u043c \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0438\u0435\u0439 \u0438 HTTP-\u0432\u0445\u043e\u0434 \u0441 \u044f\u0432\u043d\u044b\u043c\u0438 \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044f\u043c\u0438"
