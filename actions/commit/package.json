{
  "name": "commit",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run cli.ts ../../diff.patch -o ./tmp/output.md",
    "files": "bun run ../../tasks/tree-explorer/index.ts -e node_modules -e tmp",
    "join": "bun run ../join/cli.ts --file tmp/files.txt --output tmp/join.md",
    "commit": "git diff --staged > tmp/diff.patch && bun run cli.ts tmp/diff.patch -c tmp/join.md -o tmp/commit.md",
    "edit": "bun run ../edit/cli.ts tmp/edit.json"
  }
}
