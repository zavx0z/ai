{
  "name": "bun",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "files": "bun run ../../tasks/tree-explorer/index.ts -e node_modules -e tmp",
    "join": "bun run ../join/cli.ts --file tmp/files.txt --output tmp/join.md --no-numbers",
    "commit": "git diff --staged > tmp/diff.patch && bun run cli.ts tmp/diff.patch -c tmp/join.md -o tmp/commit.md"
  }
}
