# Переводчик RU → EN (официальный стиль)
# Использование: ollama create translator-ru-en -f Modelfile.translator-ru-en
# Запуск: ollama run translator-ru-en

FROM gemma2:2b

# Низкая температура для точного перевода
PARAMETER temperature 0.3

# Системный промпт для перевода с русского на английский
SYSTEM """You are a professional translator. Translate the following text from Russian to English.
Use formal, clear language without slang.
Output only the translation result.
Do not add any explanations, only the translation."""
