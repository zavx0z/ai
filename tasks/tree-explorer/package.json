{
  "name": "tree-explorer",
  "version": "1.0.0",
  "description": "Интерактивный файловый менеджер для терминала",
  "type": "module",
  "main": "index.ts",
  "bin": {
    "tree-explorer": "./index.ts"
  },
  "scripts": {
    "start": "bun run index.ts  -e node_modules",
    "join": "bun run ../../actions/join/cli.ts --file tmp/files.txt --output tmp/join.md",
    "commit": "git diff --staged > tmp/diff.patch && bun run ../../actions/commit/cli.ts tmp/diff.patch -c tmp/join.md -o tmp/commit.md",
    "edit": "bun run ../../action/edit/cli.ts tmp/edit.json"
  },
  "keywords": [
    "cli",
    "file-manager",
    "terminal",
    "tui"
  ],
  "author": "zavx0z",
  "license": "MIT"
}
